--- Fuzz testing (ADR-0092).
---
--- `fuzz.run` invokes the function `count` times with random inputs.
--- Functions should return an `err` result on failure; the report
--- counts `err` results and records the first failure payload.
--- Dispatch is ctor-sym identity via `match` (ADR-0152 §2, phase-3
--- WS-F), never a `__tag__` string.

from "serialize" import { serialize }

cap "fuzz.run"

op "fuzz.run" : (Function, Number, Number) -> Value

handle "fuzz.run" with run

do {
  generate_inputs :: [f, s, i] ~> {
    while { j: 0, acc: [] } {
      [j, acc] ~> if j == array.len(f.params) {
        { out: acc }
      } else {
        { state: {
          j: j + 1,
          acc: [...acc, rand.seeded_float(s + i * 1000 + j, 0, 1)]
        }}
      }
    }
  }

  err_res :: v ~> ({ "__ctor__": sym.seeded("data.Result.err"),
                     "value": v,
                     "type": { "__former__": sym.seeded("data.Result"),
                               "indices": [null, null] } })

  {
    run: [f, count, seed] ~> {
      s :: if seed == null { 0 } else { seed }
      if count <= 0 {
        err_res({ message: "count must be positive" })
      } else {
        while { i: 0, failures: 0, first_error: null } {
          [i, failures, first_error] ~> {
            inputs :: generate_inputs(f, s, i)
            r :: combinators.apply(f, inputs)
            m :: match r {
              err(e): { is_err: true, payload: serialize(e, "json") },
              _: { is_err: false, payload: null }
            }
            new_failures :: if m.is_err { failures + 1 } else { failures }
            new_first :: if m.is_err {
              if first_error == null { m.payload } else { first_error }
            } else {
              first_error
            }
            if i == count {
              { out: { runs: count, failures: new_failures, first_error: new_first } }
            } else {
              { state: { i: i + 1, failures: new_failures, first_error: new_first } }
            }
          }
        }
      }
    }
  }
}
