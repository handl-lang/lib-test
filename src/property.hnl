--- Property-based testing (ADR-0092).
---
--- `property.for_all` runs the predicate function `count` times with
--- deterministic seeded floats.  The predicate must return `true` to
--- pass and an `err` result to fail. Results mint the canonical
--- `__ctor__` object shape (ADR-0152 §2, phase-3 WS-F) — the same
--- record lib-result's `ok`/`err` produce — and dispatch is ctor-sym
--- identity via `match`, never a `__tag__` string.

from "serialize" import { serialize }

cap "property.for_all"

op "property.for_all" : (Function, Number, Number) -> Value

handle "property.for_all" with for_all

do {
  generate_inputs :: [f, s, i] ~> {
    while { j: 0, acc: [] } {
      [j, acc] ~> if j == array.len(f.params) {
        { out: acc }
      } else {
        { state: {
          j: j + 1,
          acc: [...acc, rand.seeded_float(s + i * 1000 + j, 0, 1)]
        }}
      }
    }
  }

  ok_res :: v ~> ({ "__ctor__": sym.seeded("data.Result.ok"),
                    "value": v,
                    "type": { "__former__": sym.seeded("data.Result"),
                              "indices": [null, null] } })
  err_res :: v ~> ({ "__ctor__": sym.seeded("data.Result.err"),
                     "value": v,
                     "type": { "__former__": sym.seeded("data.Result"),
                               "indices": [null, null] } })

  {
    for_all: [f, count, seed] ~> {
      s :: if seed == null { 0 } else { seed }
      if count <= 0 {
        err_res({ message: "count must be positive" })
      } else {
        while { i: 0 } {
          [i] ~> {
            inputs :: generate_inputs(f, s, i)
            r :: combinators.apply(f, inputs)
            if i == count {
              { out: ok_res(true) }
            } else {
              match r {
                err(e): { out: err_res({
                  message: "property failed",
                  counterexample: inputs,
                  cause: serialize(e, "json")
                })},
                _: if r != true {
                  { out: err_res({
                    message: "property returned false",
                    counterexample: inputs
                  })}
                } else {
                  { state: { i: i + 1 } }
                }
              }
            }
          }
        }
      }
    }
  }
}
